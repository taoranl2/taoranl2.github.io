# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

# Python bytecode from tools/
__pycache__/
*.pyc

# macOS finder metadata
.DS_Store

# Drop-folder for camera originals; only the web-sized copies in
# images/parks/ belong in the repository (see tools/add-park-photos.sh).
photo/
